<?xml version="1.0" encoding="utf-8"?>
<!-- Two-button vertical floating panel: Play (top) + Voice Input (bottom) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

    <!-- Play / TTS button (Apple Music inspired Green tint) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPlay"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/transparent">

        <FrameLayout
            android:id="@+id/iconBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_minimal">

            <ImageView
                android:id="@+id/iconImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                app:tint="#34C759" /> 
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Share to Doubao button (Subtle Purple tint) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardShare"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/transparent">

        <FrameLayout
            android:id="@+id/shareBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_minimal">

            <ImageView
                android:id="@+id/shareImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#AF52DE" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Voice Input button (Warm Orange tint) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMic"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/transparent">

        <FrameLayout
            android:id="@+id/micBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_minimal">

            <ImageView
                android:id="@+id/micImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="#FF9500" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Back Button (Classic Apple Blue tint) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBack"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/transparent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/backBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_minimal">

            <ImageView
                android:id="@+id/backImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#007AFF" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
