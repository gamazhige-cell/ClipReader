<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ClipReader"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="复制即朗读 零操作成本的语音助理"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="首选发声引擎"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Spinner
            android:id="@+id/spinnerPrimaryEngine"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnTestPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试选中引擎" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="备用发声引擎 (断网/报错时自动降级)"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <Spinner
            android:id="@+id/spinnerFallbackEngine"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnTestFallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试选中引擎" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Azure 配置 (仅在使用 Azure TTS 时需要)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editAzureKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Azure API Key"
        android:inputType="textPassword"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editAzureRegion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Azure Region (如 eastasia)"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存配置并启动服务"
        android:layout_marginBottom="16dp" />



    <Button
        android:id="@+id/btnStopService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="停止 ClipReader 服务"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* 使用前请确保已授予「悬浮窗」和「通知」权限\n* Android 10+ 限制后台剪切板：需在复制文本后手动单击悬浮球即可发声"
        android:textSize="14sp"
        android:textColor="#888888"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>
