heckable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,600][1027,975]" drawing-order="4" hint="" /><node index="5" text="备用引擎用 Android 系统 TTS，断网时自动切换。" resource-id="" class="android.widget.TextView" package="com.anthropic.claude" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,999][1027,1149]" drawing-order="5" hint="" /><node index="6" text="后续如果你对音质不满意，再换豆包或者本地 Sherpa-ONNX。接口是抽象的，换引擎只改一个实现类。" resource-id="" class="android.widget.TextView" package="com.anthropic.claude" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1173][1027,1398]" drawing-order="6" hint="" /><node index="7" text="你觉得这个分层合理吗？要不要我把 PRD 里的 TTS 部分更新成 Edge TTS 为主？" resource-id="" class="android.widget.TextView" package="com.anthropic.claude" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1422][1027,1572]" drawing-order="7" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.anthropic.claude" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1572][477,1699]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.anthropic.claude" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" lo